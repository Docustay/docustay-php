{
    "name": "docustay/docustay-php",
    "version": "0.2.2",
    "description": "Open-source e-signature. One flat price for every user.",
    "keywords": [
        "docustay",
        "e-signature",
        "esignature",
        "electronic-signature",
        "sdk",
        "api"
    ],
    "homepage": "https://docustay.app",
    "license": "MIT",
    "authors": [
        {
            "name": "Docustay",
            "homepage": "https://docustay.app"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "Docustay\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Docustay\\Test\\" : "test/" }
    }
}
